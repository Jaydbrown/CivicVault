# Copy to .env and fill with your own keys. Do not commit .env.

# ─── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=file:./prisma/dev.db
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Supabase (DAO chat writes — gated on on-chain membership) ─────────────────
# Posting goes through POST /api/chat/message. Run supabase-scripts/init.sql
# (or restrict-chat-inserts.sql to migrate) so the anon key can't INSERT.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Gmail OAuth (for "Connect Gmail" and chat notifications) ──────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Authorized redirect URI: http://localhost:3001/api/auth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Outbound notification emails — the mailbox that sends alerts
GMAIL_FROM_EMAIL=
GMAIL_MAILER_REFRESH_TOKEN=

# ─── RabbitMQ (optional async workers) ─────────────────────────────────────────
# Skip this for local dev — the backend starts fine without it.
# Start locally with: docker run -p 5672:5672 rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HEARTBEAT=30
RABBIT_PREFETCH=32
RABBIT_MAX_JOB_ATTEMPTS=5

# ─── Gemini AI (homepage assistant) ────────────────────────────────────────────
# Create at: aistudio.google.com → Get API key
GEMINI_API_KEY=

# ─── Privy server auth (required for /api/wallet and identity binding) ─────────
# Create at: dashboard.privy.io → your app → Settings → API keys
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Arc / on-chain (backend reads only) ──────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
FACTORY_ADDRESS=0x58Ff8ca3b9863e535845f58D5d7AA90B33fE635F
GOVERNOR_ADDRESS=0x1cE8328E08a4c93A37e5e03115BAdE0373b97310

# ─── Circle Programmable Wallets ───────────────────────────────────────────────
# Tier 1 (smartphone, user-controlled): API key + App ID + a Gas Station policy
# for the wallet set on ARC-TESTNET (SCA account type). No entity secret needed.
# Create at: console.circle.com → Wallets
CIRCLE_API_KEY=
CIRCLE_APP_ID=
CIRCLE_GAS_STATION_POLICY_ID=
# Tier 2 (USSD, custodial — Milestone 2 only):
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CUSTODIAL_WALLET_CAP_USDC=50
CUSTODIAL_MAX_APPROVE_USDC=100

# ─── Ops ─────────────────────────────────────────────────────────────────────
# Slack/Discord incoming webhook — policy rejections, failed txs, rate-limit trips
ALERT_WEBHOOK_URL=
WALLET_CALL_RATE_MAX=12

# ─── Fiat display (USSD tier sees ₦; chain holds USDC) ────────────────────────
# Stub rate until a licensed on/off-ramp partner is wired (Milestone 3).
FIAT_USD_NGN_RATE=1600

# ─── USSD tier — feature-phone access (Africa's Talking) ──────────────────────
# Callback URL to register in the AT dashboard: https://<host>/api/ussd
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# The custodial (developer-controlled) wallet keys below power the USSD tier —
# CIRCLE_ENTITY_SECRET + CIRCLE_WALLET_SET_ID above.
